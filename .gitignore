# Terraform: directorios y estados locales
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Variables que pueden contener información sensible
*.tfvars
*.tfvars.json
!*.tfvars.example
# Reviewed non-secret SEO release switches; persist across ordinary site applies.
!infra/site/seo.auto.tfvars

# Archivos locales de sustitución
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Editores y sistema operativo
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
# Respaldos locales: nunca al repo (se publicarían en el sitio)
*.bak
*.bak_*
origin certificate.txt
private key.txt
